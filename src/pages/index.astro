---
const siteTitle = "SmartGearLab";
const navLinks = [
  { name: "Smartphones", url: "/smartphones" },
  { name: "Laptops", url: "/laptops" },
  { name: "Accessories", url: "/accessories" },
  { name: "About Us", url: "/about" },
  { name: "Contact", url: "/contact" }
];

const featuredPosts = [
  {
    title: "Ergotron LX vs Fully Jarvis: Best Heavy-Duty Monitor Arm for Desk Ergonomics?",
    category: "Workspace Setup",
    date: "November 16, 2026",
    excerpt: "Stock monitor stands consume significant desktop depth while forcing your neck into static, downward-tilted viewing angles.",
    url: "#"
  },
  {
    title: "Logitech Lift vs Anker Wireless: Best Vertical Mouse for Wrist Pain?",
    category: "Workspace Setup",
    date: "November 16, 2026",
    excerpt: "Working 8 to 10 hours with a traditional flat office mouse forces your forearm into an unnatural pronated position.",
    url: "#"
  }
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{siteTitle} — Tech Comparisons & Gadget Reviews</title>
  </head>
  <body class="bg-brandGray text-slate-800 antialiased font-sans">
    
    <!-- Top Navigation Bar -->
    <header class="bg-brandDark text-white sticky top-0 z-50 shadow-md">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href="/" class="text-xl font-black tracking-wider text-white uppercase">
          Smart<span class="text-brandAccent">GearLab</span>
        </a>
        <nav class="hidden md:flex space-x-8 text-sm font-medium">
          {navLinks.map(link => (
            <a href={link.url} class="hover:text-blue-400 transition-colors">{link.name}</a>
          ))}
        </nav>
      </div>
    </header>

    <!-- Hero Section -->
    <section class="bg-slate-900 text-white py-12 px-4 sm:px-6 lg:px-8 mb-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight mb-4">
          Unbiased Tech Reviews & Buying Guides
        </h1>
        <p class="text-lg text-slate-300 max-w-2xl mx-auto">
          Your trusted source for in-depth gadget comparisons, technical benchmarks, and expert recommendations.
        </p>
      </div>
    </section>

    <!-- Main Content Grid -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- Posts Feed (Left 2 Columns) -->
        <div class="lg:col-span-2 space-y-6">
          <h2 class="text-2xl font-bold border-b pb-2 mb-6">Latest Comparisons & Reviews</h2>
          
          {featuredPosts.map(post => (
            <article class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 hover:shadow-md transition-shadow">
              <span class="text-xs font-semibold uppercase tracking-wider text-brandAccent bg-blue-50 px-2.5 py-1 rounded">
                {post.category}
              </span>
              <h3 class="text-xl font-bold mt-3 mb-2 hover:text-brandAccent transition-colors">
                <a href={post.url}>{post.title}</a>
              </h3>
              <p class="text-slate-600 text-sm mb-4 leading-relaxed">
                {post.excerpt}
              </p>
              <div class="flex items-center justify-between text-xs text-slate-400 pt-3 border-t border-slate-100">
                <span>Published {post.date}</span>
                <a href={post.url} class="text-brandAccent font-semibold hover:underline">Continue Reading &rarr;</a>
              </div>
            </article>
          ))}
        </div>

        <!-- Sidebar (Right Column) -->
        <aside class="space-y-6">
          <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
            <h3 class="font-bold text-lg mb-4 pb-2 border-b">Popular Categories</h3>
            <ul class="space-y-2 text-sm">
              <li><a href="#" class="text-slate-600 hover:text-brandAccent block py-1">Smartphones & Wearables</a></li>
              <li><a href="#" class="text-slate-600 hover:text-brandAccent block py-1">Laptops & Workstations</a></li>
              <li><a href="#" class="text-slate-600 hover:text-brandAccent block py-1">Desk Ergonomics & Accessories</a></li>
              <li><a href="#" class="text-slate-600 hover:text-brandAccent block py-1">Smart Home Gadgets</a></li>
            </ul>
          </div>

          <div class="bg-blue-900 text-white rounded-xl p-6 shadow-sm">
            <h3 class="font-bold text-lg mb-2">Affiliate Disclosure</h3>
            <p class="text-xs text-blue-200 leading-relaxed">
              SmartGearLab is reader-supported. When you buy through links on our site, we may earn an affiliate commission at no extra cost to you.
            </p>
          </div>
        </aside>

      </div>
    </main>

    <!-- Footer -->
    <footer class="bg-slate-900 text-slate-400 py-8 border-t border-slate-800">
      <div class="max-w-7xl mx-auto px-4 text-center text-sm">
        <p>&copy; 2026 SmartGearLab.org. All rights reserved.</p>
      </div>
    </footer>

  </body>
</html>
