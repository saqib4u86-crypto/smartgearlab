---
const siteTitle = "SmartGearLab";
const navLinks = [
  { name: "Smartphones", url: "/smartphones" },
  { name: "Laptops", url: "/laptops" },
  { name: "Accessories", url: "/accessories" },
  { name: "Workspace", url: "/workspace" }
];

const featuredPosts = [
  {
    title: "Ergotron LX vs Fully Jarvis: Best Heavy-Duty Monitor Arm for Desk Ergonomics?",
    category: "Workspace Setup",
    date: "November 17, 2026",
    excerpt: "Stock monitor stands consume significant desktop depth while forcing your neck into static, downward-tilted viewing angles.",
    url: "#"
  },
  {
    title: "Logitech Lift vs Anker Wireless: Best Vertical Mouse for Wrist Pain?",
    category: "Workspace Setup",
    date: "November 17, 2026",
    excerpt: "Working 8 to 10 hours with a traditional flat office mouse forces your forearm into an unnatural pronated position.",
    url: "#"
  }
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{siteTitle} — Tech Comparisons & Gadget Reviews</title>
  </head>
  <body class="bg-slate-100 text-slate-900 antialiased font-sans selection:bg-blue-600 selection:text-white">
    
    <!-- Professional Header -->
    <header class="bg-slate-900 text-white sticky top-0 z-50 border-b border-slate-800 shadow-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href="/" class="text-2xl font-black tracking-tight uppercase text-white">
          Smart<span class="text-blue-500">GearLab</span>
        </a>
        <nav class="hidden md:flex space-x-6 text-sm font-semibold tracking-wide">
          {navLinks.map(link => (
            <a href={link.url} class="hover:text-blue-400 transition-colors">{link.name}</a>
          ))}
        </nav>
      </div>
    </header>

    <!-- Authority Hero Banner -->
    <section class="bg-slate-900 text-white py-12 px-4 sm:px-6 lg:px-8 mb-8 border-b border-slate-800">
      <div class="max-w-4xl mx-auto text-center">
        <span class="text-xs font-bold tracking-widest uppercase bg-blue-600/30 text-blue-400 px-3 py-1 rounded-full border border-blue-500/30 mb-4 inline-block">
          Expert Tech Authority & Reviews
        </span>
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight mb-4 leading-tight">
          Unbiased Tech Reviews & Deep Benchmarks
        </h1>
        <p class="text-base sm:text-lg text-slate-400 max-w-2xl mx-auto leading-relaxed">
          Rigorous gadget comparisons and practical evaluations designed to help you buy with confidence.
        </p>
      </div>
    </section>

    <!-- Content Grid Layout -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- Main Feed -->
        <div class="lg:col-span-2 space-y-6">
          <div class="flex items-center justify-between border-b border-slate-300 pb-3 mb-6">
            <h2 class="text-xl font-bold uppercase tracking-wider text-slate-800">Latest Reviews</h2>
            <span class="text-xs text-slate-500 font-medium">Updated Live</span>
          </div>
          
          {featuredPosts.map(post => (
            <article class="bg-white rounded-xl shadow-sm border border-slate-200/80 p-6 hover:shadow-md transition-shadow">
              <div class="flex items-center space-x-2 mb-3">
                <span class="text-xs font-bold uppercase tracking-wider text-blue-600 bg-blue-50 px-2.5 py-1 rounded">
                  {post.category}
                </span>
                <span class="text-xs text-slate-400">• {post.date}</span>
              </div>
              <h3 class="text-xl font-bold tracking-tight mb-2 text-slate-900 hover:text-blue-600 transition-colors">
                <a href={post.url}>{post.title}</a>
              </h3>
              <p class="text-slate-600 text-sm mb-4 leading-relaxed">
                {post.excerpt}
              </p>
              <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
                <span class="text-xs font-medium text-slate-500">By SmartGearLab Editorial</span>
                <a href={post.url} class="text-sm font-bold text-blue-600 hover:underline inline-flex items-center">
                  Read Full Review &rarr;
                </a>
              </div>
            </article>
          ))}
        </div>

        <!-- Sidebar -->
        <aside class="space-y-6">
          <div class="bg-white rounded-xl shadow-sm border border-slate-200/80 p-6">
            <h3 class="font-bold text-base uppercase tracking-wider text-slate-900 mb-4 pb-2 border-b border-slate-100">
              Categories
            </h3>
            <ul class="space-y-2 text-sm font-medium">
              <li><a href="#" class="text-slate-600 hover:text-blue-600 block py-1.5 transition-colors">Smartphones & Wearables</a></li>
              <li><a href="#" class="text-slate-600 hover:text-blue-600 block py-1.5 transition-colors">Laptops & Workstations</a></li>
              <li><a href="#" class="text-slate-600 hover:text-blue-600 block py-1.5 transition-colors">Desk Ergonomics & Gear</a></li>
              <li><a href="#" class="text-slate-600 hover:text-blue-600 block py-1.5 transition-colors">Smart Home Hardware</a></li>
            </ul>
          </div>

          <div class="bg-slate-900 text-white rounded-xl p-6 shadow-sm border border-slate-800">
            <h3 class="font-bold text-base mb-2 text-blue-400">Editorial Transparency</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              SmartGearLab is independently owned. We test products rigorously and may earn affiliate commissions through our links at no extra cost to you.
            </p>
          </div>
        </aside>

      </div>
    </main>

    <!-- Professional Footer -->
    <footer class="bg-slate-900 text-slate-400 py-8 border-t border-slate-800 text-xs">
      <div class="max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4">
        <p>&copy; 2026 SmartGearLab.org. All rights reserved.</p>
        <div class="flex space-x-6">
          <a href="#" class="hover:text-white transition-colors">Privacy Policy</a>
          <a href="#" class="hover:text-white transition-colors">Affiliate Disclosure</a>
          <a href="#" class="hover:text-white transition-colors">Contact</a>
        </div>
      </div>
    </footer>

  </body>
</html>
