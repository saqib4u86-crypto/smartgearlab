---
const siteTitle = "SmartGearLab";
const navLinks = [
  { name: "Smartphones", url: "/smartphones" },
  { name: "Laptops", url: "/laptops" },
  { name: "Accessories", url: "/accessories" },
  { name: "Workspace", url: "/workspace" }
];

const featuredPosts = [
  {
    title: "Ergotron LX vs Fully Jarvis: Best Heavy-Duty Monitor Arm for Desk Ergonomics?",
    category: "Workspace Setup",
    date: "November 17, 2026",
    excerpt: "Stock monitor stands consume significant desktop depth while forcing your neck into static, downward-tilted viewing angles.",
    url: "#"
  },
  {
    title: "Logitech Lift vs Anker Wireless: Best Vertical Mouse for Wrist Pain?",
    category: "Workspace Setup",
    date: "November 17, 2026",
    excerpt: "Working 8 to 10 hours with a traditional flat office mouse forces your forearm into an unnatural pronated position.",
    url: "#"
  }
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{siteTitle} — Tech Comparisons & Gadget Reviews</title>
    <style>
      :root {
        --bg-color: #f8fafc;
        --card-bg: #ffffff;
        --text-primary: #0f172a;
        --text-secondary: #475569;
        --accent-blue: #2563eb;
        --header-bg: #0f172a;
        --border-color: #e2e8f0;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        background-color: var(--bg-color);
        color: var(--text-primary);
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }
      header {
        background-color: var(--header-bg);
        color: #ffffff;
        position: sticky;
        top: 0;
        z-index: 50;
        border-bottom: 1px solid #1e293b;
      }
      .nav-container {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 1.5rem;
        height: 4rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .logo {
        font-size: 1.5rem;
        font-weight: 900;
        text-transform: uppercase;
        color: #ffffff;
        text-decoration: none;
        letter-spacing: -0.025em;
      }
      .logo span { color: #3b82f6; }
      nav a {
        color: #cbd5e1;
        text-decoration: none;
        font-size: 0.875rem;
        font-weight: 600;
        margin-left: 1.5rem;
        transition: color 0.2s;
      }
      nav a:hover { color: #ffffff; }
      .hero {
        background-color: var(--header-bg);
        color: #ffffff;
        padding: 4rem 1.5rem;
        text-align: center;
        border-bottom: 1px solid #1e293b;
        margin-bottom: 2.5rem;
      }
      .hero-badge {
        display: inline-block;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        background: rgba(37, 99, 235, 0.2);
        color: #60a5fa;
        padding: 0.35rem 0.85rem;
        border-radius: 9999px;
        border: 1px solid rgba(96, 165, 250, 0.3);
        margin-bottom: 1rem;
      }
      .hero h1 {
        font-size: 2.5rem;
        font-weight: 800;
        margin-bottom: 1rem;
        letter-spacing: -0.025em;
      }
      .hero p {
        color: #94a3b8;
        max-width: 42rem;
        margin: 0 auto;
        font-size: 1.125rem;
      }
      .main-layout {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 1.5rem 4rem 1.5rem;
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
      }
      @media (min-width: 1024px) {
        .main-layout { grid-template-columns: 2fr 1fr; }
      }
      .feed-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 2px solid var(--border-color);
        padding-bottom: 0.75rem;
        margin-bottom: 1.5rem;
      }
      .feed-header h2 {
        font-size: 1.25rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }
      .feed-header span {
        font-size: 0.75rem;
        color: var(--text-secondary);
        font-weight: 600;
      }
      article {
        background: var(--card-bg);
        border-radius: 0.75rem;
        border: 1px solid var(--border-color);
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
        transition: box-shadow 0.2s;
      }
      article:hover { box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05); }
      .article-meta {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.75rem;
      }
      .category-tag {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--accent-blue);
        background: #eff6ff;
        padding: 0.25rem 0.5rem;
        border-radius: 0.25rem;
      }
      .date-text { font-size: 0.75rem; color: var(--text-secondary); }
      article h3 a {
        color: var(--text-primary);
        text-decoration: none;
        font-size: 1.25rem;
        font-weight: 700;
        line-height: 1.4;
      }
      article h3 a:hover { color: var(--accent-blue); }
      article p {
        color: var(--text-secondary);
        font-size: 0.95rem;
        margin: 0.75rem 0 1.25rem 0;
      }
      .article-footer {
        border-top: 1px solid var(--border-color);
        padding-top: 1rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 0.8rem;
      }
      .author { color: var(--text-secondary); font-weight: 500; }
      .read-more { color: var(--accent-blue); font-weight: 700; text-decoration: none; }
      .read-more:hover { text-decoration: underline; }
      sidebar { display: flex; flex-direction: column; gap: 1.5rem; }
      .sidebar-card {
        background: var(--card-bg);
        border-radius: 0.75rem;
        border: 1px solid var(--border-color);
        padding: 1.5rem;
        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
      }
      .sidebar-card h3 {
        font-size: 0.9rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid var(--border-color);
      }
      .sidebar-links { list-style: none; display: flex; flex-direction: column; gap: 0.5rem; }
      .sidebar-links a {
        color: var(--text-secondary);
        text-decoration: none;
        font-size: 0.875rem;
        font-weight: 500;
        display: block;
        padding: 0.25rem 0;
        transition: color 0.2s;
      }
      .sidebar-links a:hover { color: var(--accent-blue); }
      .dark-card {
        background: var(--header-bg);
        color: #ffffff;
        border: 1px solid #1e293b;
      }
      .dark-card h3 { color: #60a5fa; border-bottom-color: #1e293b; }
      .dark-card p { color: #94a3b8; font-size: 0.8rem; line-height: 1.5; }
      footer {
        background-color: var(--header-bg);
        color: #94a3b8;
        padding: 2rem 1.5rem;
        border-top: 1px solid #1e293b;
        font-size: 0.8rem;
      }
      .footer-content {
        max-width: 1280px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }
      @media (min-width: 640px) {
        .footer-content { flex-direction: row; }
      }
      .footer-links { display: flex; gap: 1.5rem; }
      .footer-links a { color: #94a3b8; text-decoration: none; transition: color 0.2s; }
      .footer-links a:hover { color: #ffffff; }
    </style>
  </head>
  <body>
    
    <!-- Professional Header -->
    <header>
      <div class="nav-container">
        <a href="/" class="logo">Smart<span>GearLab</span></a>
        <nav>
          {navLinks.map(link => (
            <a href={link.url}>{link.name}</a>
          ))}
        </nav>
      </div>
    </header>

    <!-- Authority Hero Banner -->
    <section class="hero">
      <div style="max-width: 800px; margin: 0 auto;">
        <span class="hero-badge">Expert Tech Authority & Reviews</span>
        <h1>Unbiased Tech Reviews & Deep Benchmarks</h1>
        <p>Rigorous gadget comparisons and practical evaluations designed to help you buy with confidence.</p>
      </div>
    </section>

    <!-- Content Grid Layout -->
    <main class="main-layout">
      <div>
        <div class="feed-header">
          <h2>Latest Reviews</h2>
          <span>Updated Live</span>
        </div>
        
        {featuredPosts.map(post => (
          <article>
            <div class="article-meta">
              <span class="category-tag">{post.category}</span>
              <span class="date-text">• {post.date}</span>
            </div>
            <h3><a href={post.url}>{post.title}</a></h3>
            <p>{post.excerpt}</p>
            <div class="article-footer">
              <span class="author">By SmartGearLab Editorial</span>
              <a href={post.url} class="read-more">Read Full Review &rarr;</a>
            </div>
          </article>
        ))}
      </div>

      <!-- Sidebar -->
      <sidebar>
        <div class="sidebar-card">
          <h3>Categories</h3>
          <ul class="sidebar-links">
            <li><a href="#">Smartphones & Wearables</a></li>
            <li><a href="#">Laptops & Workstations</a></li>
            <li><a href="#">Desk Ergonomics & Gear</a></li>
            <li><a href="#">Smart Home Hardware</a></li>
          </ul>
        </div>

        <div class="sidebar-card dark-card">
          <h3>Editorial Transparency</h3>
          <p>SmartGearLab is independently owned. We test products rigorously and may earn affiliate commissions through our links at no extra cost to you.</p>
        </div>
      </sidebar>
    </main>

    <!-- Professional Footer -->
    <footer>
      <div class="footer-content">
        <p>&copy; 2026 SmartGearLab.org. All rights reserved.</p>
        <div class="footer-links">
          <a href="#">Privacy Policy</a>
          <a href="#">Affiliate Disclosure</a>
          <a href="#">Contact</a>
        </div>
      </div>
    </footer>

  </body>
</html>
